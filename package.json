{
  "name": "popu-club",
  "private": true,
  "description": "Plataforma de cómics Popu-Club de Cherry Bless",
  "author": "Cherry Bless",
  "version": "1.0.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:prepare": "node scripts/prepare-electron.mjs",
    "electron:build": "npm run build && npm run electron:prepare && node scripts/build-electron.mjs --win",
    "electron:build:linux": "npm run build && npm run electron:prepare && node scripts/build-electron.mjs --linux",
    "electron:build:mac": "npm run build && npm run electron:prepare && node scripts/build-electron.mjs --mac",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@supabase/supabase-js": "^2.117.2",
    "firebase": "^12.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-easy-crop": "^6.2.3",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0"
  },
  "build": {
    "appId": "com.cherrybless.popuclub",
    "productName": "Popu-Club",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "app": "build/desktop",
      "output": "electron-dist/${version}"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png"
    ],
    "icon": "build/icon.png",
    "win": {
      "icon": "build/icon.png",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
